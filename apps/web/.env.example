# Cấu hình web (Vite chỉ đọc biến có tiền tố VITE_). Sao chép thành apps/web/.env: cp apps/web/.env.example apps/web/.env
# Giá trị được nhúng vào bản build, nên không đặt bí mật ở đây. Đổi xong thì chạy lại pnpm dev:web.

# Địa chỉ API, gồm cả /api/v1. Bản Docker dùng /api/v1 (nginx chuyển tiếp).
VITE_API_URL=http://localhost:3000/api/v1

# Bản đồ (MapLibre). Mặc định dùng nền OpenFreeMap và tìm địa chỉ Photon, không cần token.
# VITE_MAP_ENABLED=false            # tắt mọi bản đồ, trang vẫn chạy
# VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# VITE_GEOCODING_URL=https://photon.komoot.io/api/
# Nền ảnh của bản đồ lập tuyến (Leaflet) ở màn điều phối:
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
