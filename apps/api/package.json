{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean-build.cjs && tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "start:dev": "nodemon",
    "start:prod": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "test": "node --test test/*.test.cjs",
    "test:mysql:flow4": "node test/flow4-tracking.mysql.cjs"
  },
  "dependencies": {
    "@my-project/shared": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.5",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.11.4",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "zod": "^3.25",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.17.0",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
