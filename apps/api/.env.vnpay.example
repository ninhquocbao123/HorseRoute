# Copy these keys into apps/api/.env. Obtain both values from your VNPAY Sandbox registration.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Frontend return page (use your actual frontend URL)
VNPAY_RETURN_URL=http://localhost:5173/payments/vnpay/return
# Register this callback URL with VNPAY (replace the hostname with your public API host):
# https://YOUR_PUBLIC_API_HOST/api/v1/payments/vnpay/ipn
