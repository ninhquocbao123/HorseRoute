{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "NODE_ENV=development pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @my-project/shared build && pnpm --filter api build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
