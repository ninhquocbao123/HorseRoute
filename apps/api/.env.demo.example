# Mẫu cấu hình API chạy với DB demo cục bộ (docs/demo-local.md). Sao chép thành apps/api/.env.demo (đã gitignore) rồi chạy: pnpm dev:api:demo
# Giá trị dưới đây chỉ dành cho máy local; KHÔNG dùng cho Aiven/production và không đặt thông tin thật vào file mẫu.
NODE_ENV=development
PORT=3010
CORS_ORIGIN=http://localhost:5180,http://127.0.0.1:5180
DB_HOST=127.0.0.1
DB_PORT=33062
DB_NAME=wdp_flow4_demo
DB_USER=root
DB_PASSWORD=<mật khẩu root của container demo, xem docs/demo-local.md>
DB_SSL=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=<chuỗi ngẫu nhiên từ 32 ký tự>
DOCUMENT_STORAGE_PROVIDER=local
# Tuỳ chọn: có token thì tuyến chưa có trong cache được lấy từ Mapbox; không có thì vẽ đường thẳng ước lượng.
# Token dùng ở backend cho Geocoding v6 và Directions. Không commit giá trị thật.
# Vì route_plan lưu tọa độ/nhãn tìm kiếm, tài khoản phải được phép Permanent Geocoding.
MAPBOX_ACCESS_TOKEN=
