# Cấu hình API (và docker-compose.yml). Sao chép thành .env ở thư mục gốc: cp .env.example .env
# API đọc apps/api/.env trước rồi tới .env ở gốc; biến đã đặt sẵn trong shell luôn được ưu tiên.
# Giá trị dưới đây khớp docker-compose.dev.yml (MySQL root/root, Redis không mật khẩu) và chỉ dùng trên máy mình.
# Không đưa mật khẩu, khóa thật vào file mẫu này.

NODE_ENV=development
PORT=3000
# Địa chỉ web được gọi API, nhiều địa chỉ cách nhau bằng dấu phẩy.
CORS_ORIGIN=http://localhost:5173

# Bắt buộc, ít nhất 32 ký tự. Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# MySQL 8. `pnpm db:setup` tự tạo database DB_NAME nếu chưa có.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=horseroute
DB_USER=root
DB_PASSWORD=root
# MySQL trên dịch vụ đám mây thường bắt SSL: đặt true và trỏ DB_SSL_CA_PATH tới file CA (đường dẫn tuyệt đối).
DB_SSL=false
DB_SSL_CA_PATH=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Nơi lưu giấy tờ, ảnh: local (thư mục trên máy) hoặc supabase.
DOCUMENT_STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_DIR=var/private-documents
# Chỉ cần khi DOCUMENT_STORAGE_PROVIDER=supabase:
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=wdp-documents

# Bản đồ và tuyến đường. Không đặt: dùng OSRM và Photon công khai, không cần token.
# Đặt rỗng: tắt dịch vụ, tuyến vẽ đường thẳng ước lượng.
# OSRM công khai chỉ cho dùng phi thương mại, tối đa 1 yêu cầu/giây: production nên tự host.
# MAP_ROUTING_URL=https://router.project-osrm.org/route/v1/driving/
# MAP_GEOCODING_URL=https://photon.komoot.io/api/
# Tính quãng đường lúc khách đặt chuyến (gốc của OSRM và Photon):
# ROUTE_ROUTER_URL=https://router.project-osrm.org
# ROUTE_GEOCODER_URL=https://photon.komoot.io
# Khóa ký bản xem trước tuyến; không đặt thì dùng JWT_SECRET.
# ROUTE_PREVIEW_SECRET=
# Số ngày giữ điểm GPS chi tiết.
# TRACK_POSITION_RETENTION_DAYS=30

# VNPay Sandbox. Để trống thì chỉ thanh toán mô phỏng chạy được, chọn VNPay sẽ báo chưa cấu hình. Xem apps/api/VNPAY-SANDBOX.md.
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_RETURN_URL=http://localhost:5173/payments/vnpay/return

# Gửi email (xác minh email khi đăng ký, quên mật khẩu) qua Gmail SMTP, miễn phí khoảng 500 email/ngày.
# 1. Dùng một Gmail riêng cho dự án, bật Xác minh 2 bước: https://myaccount.google.com/security
# 2. Tạo Mật khẩu ứng dụng (App passwords): https://myaccount.google.com/apppasswords , chép chuỗi 16 ký tự vào SMTP_PASSWORD.
# Không đặt SMTP_USER/SMTP_PASSWORD: đăng ký kích hoạt ngay, mã quên mật khẩu chỉ ghi vào log của API (khi không phải production).
# SMTP_USER=horseroute.app@gmail.com
# SMTP_PASSWORD=
# MAIL_FROM=HorseRoute <horseroute.app@gmail.com>
# Dịch vụ SMTP khác thì đặt thêm: SMTP_HOST=  SMTP_PORT=587
# Bắt buộc hoặc tắt xác minh email khi đăng ký (mặc định: bật khi đã cấu hình SMTP).
# EMAIL_VERIFICATION=true

# Chỉ dùng cho docker-compose.yml (bản chạy giống production).
# DB_ROOT_PASSWORD=
