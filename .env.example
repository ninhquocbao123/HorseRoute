# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MySQL (dev local: DB_HOST=localhost | trong Docker: DB_HOST=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=myapp
DB_USER=myapp
DB_PASSWORD=myapp
DB_ROOT_PASSWORD=root

# Redis (dev local: localhost | trong Docker: redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Admin (BE) - private key giữ nguyên \n, bọc dấu nháy kép
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Firebase Client (FE)
VITE_API_URL=http://localhost:3000/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
