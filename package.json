{
  "name": "my-project",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api:demo": "node apps/api/scripts/run-demo-api.cjs",
    "dev:web:demo": "node apps/web/scripts/run-demo-web.cjs",
    "build": "pnpm --filter @my-project/shared build && pnpm -r --filter \"!@my-project/shared\" build",
    "lint": "pnpm -r lint",
    "migration:run": "pnpm --filter api migration:run",
    "db:setup": "pnpm --filter api db:setup",
    "db:create-user": "pnpm --filter api db:create-user",
    "db:local": "node docker/local-db/local-db.cjs",
    "db:local:reset": "node docker/local-db/local-db.cjs --reset"
  }
}
